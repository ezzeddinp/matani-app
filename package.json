{
  "name": "matani-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --go",
    "start:clear": "expo start --go --clear",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --go --android",
    "ios": "expo start --go --ios",
    "web": "expo start --web",
    "lint": "expo lint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/m0-artifacts.test.mjs",
    "test:backend": "npm --prefix backend test",
    "test:research": "node scripts/run-research-tests.mjs",
    "pilot:cdse": "node research/scripts/run-cdse-pilot.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run test:backend && npm run test:research",
    "db:test": "npx supabase test db",
    "db:reset": "npx supabase db reset",
    "db:types": "node scripts/generate-db-types.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "2.5.0",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.3.16",
    "@supabase/supabase-js": "^2.58.0",
    "expo": "~54.0.36",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.19",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "baseline-browser-mapping": "^2.10.29",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~10.0.0",
    "eslint-import-resolver-typescript": "^3.10.1",
    "typescript": "5.9"
  },
  "private": true,
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
