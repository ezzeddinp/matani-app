{
  "name": "matani-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --go",
    "start:clear": "expo start --go --clear",
    "start:dev-client": "expo start --dev-client",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:development:ios": "npx eas-cli@23.2.0 build --platform ios --profile development",
    "web": "expo start --web",
    "lint": "eslint app components constants hooks utils app.config.ts eslint.config.js --max-warnings=0 --no-cache",
    "typecheck": "tsc --noEmit",
    "typecheck:backend": "npm --prefix backend run typecheck",
    "audit:env": "node scripts/audit-env-boundaries.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:backend": "npm --prefix backend test",
    "test:research": "node scripts/run-research-tests.mjs",
    "pilot:cdse": "node research/scripts/run-cdse-pilot.mjs",
    "study:cdse": "node research/scripts/run-cdse-availability-study.mjs",
    "verify": "npm run lint && npm run typecheck && npm run typecheck:backend && npm run test && npm run test:backend && npm run test:research",
    "db:test": "npx supabase test db",
    "db:reset": "npx supabase db reset",
    "db:types": "node scripts/generate-db-types.mjs",
    "doctor": "react-doctor"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "2.5.0",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.3.16",
    "@supabase/supabase-js": "^2.58.0",
    "expo": "~57.0.20",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.18",
    "expo-document-picker": "~57.0.1",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-location": "~57.0.16",
    "expo-router": "~57.0.19",
    "expo-sharing": "~57.0.18",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-updates": "~57.0.21",
    "expo-web-browser": "~57.0.2",
    "proj4": "^2.19.10",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "baseline-browser-mapping": "^2.10.29",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~10.0.0",
    "eslint-import-resolver-typescript": "^3.10.1",
    "react-doctor": "0.9.12",
    "typescript": "5.9"
  },
  "private": true,
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
