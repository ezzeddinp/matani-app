# Required, Server-side Supabase Auth verification
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Required in production; comma-separated mobile/web origins
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# Optional security limits
PORT=5001
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
MAX_JSON_BYTES=65536
MAX_BBOX_AREA_HA=1000

# Required, Server-secret — Sentinel Hub OAuth client ID (Sentinel Hub dashboard > OAuth clients)
SENTINEL_CLIENT_ID=your-sentinel-client-id

# Required, Server-secret — Sentinel Hub OAuth client secret (Sentinel Hub dashboard > OAuth clients)
SENTINEL_CLIENT_SECRET=your-sentinel-client-secret

# Optional provider endpoint overrides; CDSE migration uses environment-specific endpoints
SENTINEL_TOKEN_URL=https://services.sentinel-hub.com/oauth/token
SENTINEL_STATISTICS_URL=https://services.sentinel-hub.com/api/v1/statistics

# Required, Server-secret — AccuWeather API key (AccuWeather developer portal)
ACCUWEATHER_API_KEY=your-accuweather-api-key
ACCUWEATHER_BASE_URL=https://dataservice.accuweather.com
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# Required, Server-secret — Google AI Studio / Gemini API key (https://aistudio.google.com/apikey)
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key

# Disabled unless explicitly enabled
AI_SUMMARY_ENABLED=false

# Optional — overrides the default Gemini model name used by backend/api/ai/route.js
MATANI_GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
