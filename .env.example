# Optional, Development-only — LAN IP or hostname of local backend dev server (e.g. 192.168.1.5)
EXPO_PUBLIC_API_HOST=192.168.1.5

# Optional, Development-only — backend dev server port (defaults to 5001 if unset)
EXPO_PUBLIC_API_PORT=5001

# Optional — full override URL for the backend API; takes precedence over host/port/protocol
EXPO_PUBLIC_API_URL=https://your-backend.example.com

# Optional, Development-only — API protocol (defaults to http)
EXPO_PUBLIC_API_PROTOCOL=http

# Required, Build-time client-visible — Supabase project URL (Supabase dashboard > Project Settings > API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Required, Build-time client-visible — Supabase anon/publishable key (Supabase dashboard > Project Settings > API)
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# Optional — Supabase storage bucket name for lahan thumbnails (defaults to lahan-thumbnails)
EXPO_PUBLIC_SUPABASE_LAHAN_THUMBNAIL_BUCKET=lahan-thumbnails

# Optional — auth email redirect URL for Supabase signUp
EXPO_PUBLIC_SUPABASE_REDIRECT_URL=mataniapp://auth/callback

# Development-only, Optional — fallback user id used only in dev/testing screens
EXPO_PUBLIC_SUPABASE_DEFAULT_USER_ID=your-dev-user-uuid

# Required, Build-time client-visible — Google Maps SDK key for iOS (Google Cloud Console > APIs & Services > Credentials; consumed by app.config.ts at build time)
GOOGLE_MAPS_API_KEY_IOS=your-ios-google-maps-api-key

# Required, Build-time client-visible — Google Maps SDK key for Android (Google Cloud Console > APIs & Services > Credentials; consumed by app.config.ts at build time)
GOOGLE_MAPS_API_KEY_ANDROID=your-android-google-maps-api-key
