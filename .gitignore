# dependencies
node_modules/
node_modules.stale-*/
~$*.docx

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# env files (do not commit secrets)
.env
.env.local
.env.*.local
backend/.env
!.env.example
!backend/.env.example

# typescript
*.tsbuildinfo

# Python research runtime
__pycache__/
*.py[cod]

app-example

# generated native folders
/ios
/android

# sensitive research inputs and bounded live-run artifacts
research/private/
research/outputs/live-*.json

# local Supabase CLI link/runtime metadata
supabase/.temp/
.vercel
.env*
